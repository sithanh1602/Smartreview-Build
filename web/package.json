{
  "name": "smartreview-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare.ts",
    "dev": "node scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc && tsc -p tests",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:ui": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import": "node scripts/import.ts",
    "import:demo": "node scripts/prepare.ts",
    "test:core": "node --test tests/core.test.ts",
    "db:migrate": "node scripts/migrate.ts",
    "storage:push": "node scripts/storage-push.ts",
    "user:create": "node scripts/user.ts",
    "user:update": "node scripts/user.ts --update",
    "db:prepare": "node scripts/db-prepare.ts",
    "guideline:extract": "node scripts/guideline.ts",
    "policy:check": "node scripts/policy.ts",
    "verify": "node scripts/verify.ts",
    "risk3d": "node scripts/risk3d.ts",
    "analyze": "node scripts/analyze.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@mediapipe/tasks-vision": "^1.1.0",
    "ajv": "^8.20.0",
    "busboy": "^1.6.0",
    "fast-xml-parser": "^5.11.2",
    "mysql2": "^3.24.5",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.16",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "^7.0.2",
    "vite": "7.1.12"
  },
  "engines": {
    "node": ">=22.18"
  }
}
