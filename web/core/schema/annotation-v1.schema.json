{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:smartreview:annotation:1.0.0",
  "title": "SmartReview Annotation Dataset 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/media"
      },
      "minItems": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/frame"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/annotation"
      }
    }
  },
  "required": ["schema_version", "dataset", "media", "frames", "annotations"],
  "additionalProperties": false,
  "definitions": {
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["human", "model", "import", "unknown"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["image", "video"]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      },
      "required": ["id", "name", "type", "width", "height"],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "media_id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["id", "media_id", "index"],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "$ref": "#/definitions/geometry"
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": ["id", "frame_id", "label", "geometry"],
      "additionalProperties": false
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bbox"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": ["type", "x", "y", "width", "height"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polygon"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 3
            }
          },
          "required": ["type", "points"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polyline"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 2
            }
          },
          "required": ["type", "points"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "mask"
            },
            "encoding": {
              "enum": ["rle"]
            },
            "size": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "counts": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              ]
            }
          },
          "required": ["type", "encoding", "size", "counts"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cuboid"
            },
            "center": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "coordinate_system": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["type", "center", "size", "rotation", "coordinate_system"],
          "additionalProperties": false
        }
      ]
    }
  }
}
