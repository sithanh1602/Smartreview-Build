# Backend only. Never prefix database secrets with VITE_.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartreview
DB_USER=thanhdev
DB_PASSWORD=123456
# Separate test database; never use the application database for tests.
TEST_DB_NAME=smartreview_test
# SMARTREVIEW_DATASET=datasets/demo/dataset.json
# PORT=3100
# Set true when serving over HTTPS. Required with NODE_ENV=production.
# AUTH_COOKIE_SECURE=true

# Shared project storage on Dropbox. Backend only. Never prefix with VITE_.
SMARTREVIEW_REMOTE_STORAGE=dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Optional absolute directory for uploaded projects (default web/storage).
# SMARTREVIEW_STORAGE=/path/to/smartreview-storage

# 3D projects (docs/projects-3d.md): a Python with numpy and pyarrow that converts the Waymo
# parquet files. Default <smartreview>/.venv/bin/python. Backend only.
# SMARTREVIEW_3D_PYTHON=/absolute/path/to/python

# CVAT (Scan QA panel, and "Đưa vào CVAT" for annotators: docs/review-handoff.md). Backend only.
# CVAT_BASE_URL is the API the server calls; CVAT_UI_URL is where the browser opens a task
# (default CVAT_BASE_URL; e.g. http://localhost:8081 to open it through cvat-panel's proxy).
# CVAT_BASE_URL=http://localhost:8080/
# CVAT_TOKEN=
# CVAT_UI_URL=

# AI Check model (docs/ai-check.md). Backend only. Never prefix with VITE_.
# SMARTREVIEW_AI_PYTHON=/absolute/path/to/python
# SMARTREVIEW_AI_MODEL=/absolute/path/to/fine-tuned.pt
# Set true when the model was fine-tuned on the projects' own classes: annotations the model
# sees nothing at are then reported as possibly extra.
# SMARTREVIEW_AI_FINETUNED=true

# Guideline -> rule drafts (npm run guideline:extract). Backend only. Never prefix with VITE_.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults: the lite model with medium thinking. Low thinking is faster but skipped rules in testing.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=medium
# Optional: path (relative to web/) of the guideline-rules repo. When set, the guideline is
# analysed line by line by that repo instead of in one call by server/guideline/model-call.ts.
# GUIDELINE_RULES_DIR=../../guideline-rules

# Label verifier (docs/label-verifier.md): two engines that check each box's label against the
# pixels inside it. Each model has its own folder next to SmartReview; paths are relative to
# web/. A folder is filled by server/verify/download_models.py. Without a folder the model is
# taken from the Hugging Face cache. Backend only.
# The scan popup lists the models found in LABEL_VERIFIER_MODELS_DIR (default ../model-usage,
# git-ignored): one folder per model, holding config.json and .safetensors/.bin weights.
# LABEL_VERIFIER_MODELS_DIR=../model-usage
# LABEL_VERIFIER_SIGLIP_DIR=../../siglip2-base-patch16-224
# LABEL_VERIFIER_QWEN_DIR=../../Qwen2.5-VL-3B-Instruct
# Optional: a Python other than <smartreview>/.venv/bin/python.
# LABEL_VERIFIER_PYTHON=/absolute/path/to/python

# Optional SSH tunnel before npm run dev. Requires the ssh command on your machine.
# Set DB_HOST=127.0.0.1 and DB_PORT=13306 when enabled.
DEV_SSH_TUNNEL=false
DEV_SSH_HOST=
DEV_SSH_USER=
DEV_SSH_PORT=22
DEV_SSH_DB_PORT=3306
