# Backend only. Never prefix database secrets with VITE_.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartreview
DB_USER=smartreview_app
DB_PASSWORD=replace-with-your-local-password
# Separate test database; never use the application database for tests.
TEST_DB_NAME=smartreview_test
# SMARTREVIEW_DATASET=datasets/demo/dataset.json
# PORT=3100

# Optional absolute directory for uploaded projects (default web/storage).
# SMARTREVIEW_STORAGE=/path/to/smartreview-storage
