  rev -> api: "POST /handoff {annotator_ids, note}"
  api -> db: "Snapshot ERROR + missing regions; trạng thái SENT"
  api -> rev: "201; khóa ghi case / frame → 423"
  ann -> api: "Đọc báo cáo; tải /handoff/dataset.zip nếu dataset ảnh"
  api -> ann: "annotations.xml + images/"
  ann -> cvat: "Import ZIP / sửa nhãn / export annotation"
  cvat -> ann: "Các file nhãn đã sửa"
  ann -> api: "POST /handoff/return {files:[{name,text}]}"
  api -> api: "So sánh changed / removed / added / unchanged / not_added"
  api -> db: "Revision mới; giữ quyết định của class + geometry không đổi"
  api -> ann: "Kết quả trả nhãn; RETURNED"
  rev -> api: "Tiếp tục review revision mới hoặc reopen khi cần"
}
