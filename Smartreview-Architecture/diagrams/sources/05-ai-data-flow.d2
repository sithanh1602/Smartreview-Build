heading: "05 · BA LUỒNG AI CỦA PROJECT 2D" {shape: text; near: top-center; style: {font-size: 28; bold: true; font-color: "#172B4D"}}
caption: "Data flow · Không suy diễn AI Check thay đổi điểm Risk Engine" {shape: text; near: bottom-center; style: {font-size: 16; font-color: "#52657E"}}
direction: right
import: A / Import rescore — tùy chọn khi import {
  class: boundary
  direction: right
  input: "Ảnh + bbox gốc" {class: ui}
  model: "rescore.py → score_boxes.py\nYOLO11s mặc định • CPU 1280" {class: ai}
  data: "attributes.rescore\nmetadata.missing_hints" {class: service}
  risk: "Risk Engine 7.1.0\nTính score / triage\nSinh missing cases" {class: service}
  input -> model: Ảnh / box
  model -> data: Tín hiệu bổ sung
  data -> risk: Trước khi lập revision
}
compare: B / AI Check — yêu cầu sau READY {
  class: boundary
  direction: right
  input: "Ảnh + annotation đã import" {class: ui}
  model: "predict.py\nYOLO11n mặc định" {class: ai}
  result: "So khớp predictions\nai/latest.json" {class: service}
  note: "Kết quả so sánh riêng\nKhông đổi risk score\nExtra chỉ khi fine-tuned" {class: note}
  input -> model: Tối đa 1000 ảnh
  model -> result: Class / bbox / confidence
  result -> note: Hiển thị riêng
}
verify: C / Label Verify — SigLIP, Qwen khi người dùng yêu cầu {
  class: boundary
  direction: right
  input: "BBox crops + candidate labels" {class: ui}
  model: "verify.py\nSigLIP2 → Qwen second opinion" {class: ai}
  result: "verify/latest.json\nAugment findings + requeue SQL" {class: service}
  note: "Có thể tăng score case / queue\nKhông sửa annotation gốc\nQwen không cộng thêm score" {class: note}
  input -> model: Một scan thành công / revision
  model -> result: Wrong-label evidence
  result -> note: Replay khi tải context
}
